# Imagen base con runtime ASP.NET Core 8
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 8080

# Imagen build con SDK
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copiar csproj y restaurar dependencias
COPY ["WebProyectoAPI/WebProyectoAPI.csproj", "WebProyectoAPI/"]
RUN dotnet restore "WebProyectoAPI/WebProyectoAPI.csproj"

# Copiar el resto del código y compilar
COPY . .
WORKDIR "/src/WebProyectoAPI"
RUN dotnet build "WebProyectoAPI.csproj" -c Release -o /app/build

# Publicar
FROM build AS publish
RUN dotnet publish "WebProyectoAPI.csproj" -c Release -o /app/publish

# Imagen final para ejecutar la app
FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "WebProyectoAPI.dll"]
